{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/kit\" hook" }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(./kit:*)",
      "Bash(date:*)",
      "Bash(ls:*)"
    ],
    "deny": [
      "Read(./.env*)",
      "Read(./secrets/**)",
      "Edit(./core/**)",
      "Edit(./security/**)",
      "Edit(./spec/**)",
      "Edit(./setup/**)",
      "Edit(./kit)",
      "Edit(./kit.cmd)",
      "Edit(./AGENTS.md)",
      "Edit(./.claude/**)",
      "Edit(./worklog/**)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(sudo:*)",
      "Bash(git push:*)"
    ]
  }
}
