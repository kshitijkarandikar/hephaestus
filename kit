#!/bin/sh
# Runs the kit program. Needs Python 3 (python3 or python).
ROOT=$(cd "$(dirname "$0")" && pwd)
for PY in python3 python; do
  if command -v "$PY" >/dev/null 2>&1 && "$PY" -c 'import sys; sys.exit(0 if sys.version_info[0]==3 else 1)' 2>/dev/null; then
    PYTHONDONTWRITEBYTECODE=1 exec "$PY" "$ROOT/core/kit.py" "$@"
  fi
done
echo "Python 3 is not installed. Mac: run 'xcode-select --install'. Windows: run 'winget install Python.Python.3.12'. Then try again." >&2
exit 1
